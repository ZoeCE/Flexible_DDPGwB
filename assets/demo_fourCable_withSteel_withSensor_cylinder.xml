<mujoco model="iiwa14_lifting_scene_sensors_compatible">

  <!-- arm + plate + ropes -->
  <include file="iiwa14_four_cables_with_plate.xml"/>

  <option integrator="implicitfast" gravity="0 0 -9.81"/>

  <asset>
    <material name="groundplane" rgba="0.3 0.3 0.3 1"/>
    <material name="concrete" rgba="0.7 0.7 0.7 1.0"/>
    <material name="target_mat" rgba="0.8 0.0 0.0 0.4"/>
  </asset>

  <worldbody>
    <!-- lighting & ground -->
    <light pos="1.5 0 1.5" dir="1 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- target: visual-only goal marker (no collision) -->
    <body name="target" pos="0.3 0.25 0">
      <geom name="rebar_0" type="cylinder" size="0.003 0.01" pos="0.035 0.035 0.01" rgba="0.8 0.0 0.0 1.0" contype="1" conaffinity="1"/>
      <geom name="rebar_1" type="cylinder" size="0.003 0.01" pos="0.035 -0.035 0.01" rgba="0.8 0.0 0.0 1.0" contype="1" conaffinity="1"/>
      <geom name="rebar_2" type="cylinder" size="0.003 0.01" pos="-0.035 0.035 0.01" rgba="0.8 0.0 0.0 1.0" contype="1" conaffinity="1"/>
      <geom name="rebar_3" type="cylinder" size="0.003 0.01" pos="-0.035 -0.035 0.01" rgba="0.8 0.0 0.0 1.0" contype="1" conaffinity="1"/>
    </body>

    <!-- prefab: payload with free joint -->
    <body name="prefab" pos="0.3 0.15 0.5">
      <joint type="free"/>
      <geom name="socket_top" type="box" size="0.05 0.05 0.070000" pos="0 0 0.030000" material="concrete" mass="0.045455"/>
      <geom name="socket_b1" type="box" size="0.004000 0.004000 0.030000" pos="-0.046000 -0.046000 -0.070000" material="concrete" mass="0.045455"/>
      <geom name="socket_b2" type="box" size="0.004000 0.007000 0.030000" pos="-0.046000 -0.035000 -0.070000" material="concrete" mass="0.045455"/>
      <geom name="socket_b3" type="box" size="0.004000 0.028000 0.030000" pos="-0.046000 0.000000 -0.070000" material="concrete" mass="0.045455"/>
      <geom name="socket_b4" type="box" size="0.004000 0.007000 0.030000" pos="-0.046000 0.035000 -0.070000" material="concrete" mass="0.045455"/>
      <geom name="socket_b5" type="box" size="0.004000 0.004000 0.030000" pos="-0.046000 0.046000 -0.070000" material="concrete" mass="0.045455"/>
      <geom name="socket_b6" type="box" size="0.007000 0.004000 0.030000" pos="-0.035000 -0.046000 -0.070000" material="concrete" mass="0.045455"/>
      <geom name="socket_b7" type="box" size="0.007000 0.028000 0.030000" pos="-0.035000 0.000000 -0.070000" material="concrete" mass="0.045455"/>
      <geom name="socket_b8" type="box" size="0.007000 0.004000 0.030000" pos="-0.035000 0.046000 -0.070000" material="concrete" mass="0.045455"/>
      <geom name="socket_b9" type="box" size="0.028000 0.004000 0.030000" pos="0.000000 -0.046000 -0.070000" material="concrete" mass="0.045455"/>
      <geom name="socket_b10" type="box" size="0.028000 0.007000 0.030000" pos="0.000000 -0.035000 -0.070000" material="concrete" mass="0.045455"/>
      <geom name="socket_b11" type="box" size="0.028000 0.028000 0.030000" pos="0.000000 0.000000 -0.070000" material="concrete" mass="0.045455"/>
      <geom name="socket_b12" type="box" size="0.028000 0.007000 0.030000" pos="0.000000 0.035000 -0.070000" material="concrete" mass="0.045455"/>
      <geom name="socket_b13" type="box" size="0.028000 0.004000 0.030000" pos="0.000000 0.046000 -0.070000" material="concrete" mass="0.045455"/>
      <geom name="socket_b14" type="box" size="0.007000 0.004000 0.030000" pos="0.035000 -0.046000 -0.070000" material="concrete" mass="0.045455"/>
      <geom name="socket_b15" type="box" size="0.007000 0.028000 0.030000" pos="0.035000 0.000000 -0.070000" material="concrete" mass="0.045455"/>
      <geom name="socket_b16" type="box" size="0.007000 0.004000 0.030000" pos="0.035000 0.046000 -0.070000" material="concrete" mass="0.045455"/>
      <geom name="socket_b17" type="box" size="0.004000 0.004000 0.030000" pos="0.046000 -0.046000 -0.070000" material="concrete" mass="0.045455"/>
      <geom name="socket_b18" type="box" size="0.004000 0.007000 0.030000" pos="0.046000 -0.035000 -0.070000" material="concrete" mass="0.045455"/>
      <geom name="socket_b19" type="box" size="0.004000 0.028000 0.030000" pos="0.046000 0.000000 -0.070000" material="concrete" mass="0.045455"/>
      <geom name="socket_b20" type="box" size="0.004000 0.007000 0.030000" pos="0.046000 0.035000 -0.070000" material="concrete" mass="0.045455"/>
      <geom name="socket_b21" type="box" size="0.004000 0.004000 0.030000" pos="0.046000 0.046000 -0.070000" material="concrete" mass="0.045455"/>

      <!-- four lift sites at top corners -->
      <site name="lift_fl" pos=" 0.05  0.05  0.1" size="0.01" rgba="1 0 0 1"/>
      <site name="lift_fr" pos=" 0.05 -0.05  0.1" size="0.01" rgba="1 0 0 1"/>
      <site name="lift_rl" pos="-0.05  0.05  0.1" size="0.01" rgba="1 0 0 1"/>
      <site name="lift_rr" pos="-0.05 -0.05  0.1" size="0.01" rgba="1 0 0 1"/>

      <!-- IMU sensor mount -->
      <site name="imu_site" pos="0 0 0" size="0.01" rgba="0 1 0 1"/>
    </body>
  </worldbody>

  <actuator>
    <position name="j1_motor" joint="joint1" ctrlrange="-2.96 2.96" forcerange="-300 300" kp="3000" kv="100"/>
    <position name="j2_motor" joint="joint2" ctrlrange="-2.09 2.09" forcerange="-300 300" kp="3000" kv="100"/>
    <position name="j3_motor" joint="joint3" ctrlrange="-2.96 2.96" forcerange="-300 300" kp="3000" kv="100"/>
    <position name="j4_motor" joint="joint4" ctrlrange="-2.09 2.09" forcerange="-300 300" kp="3000" kv="100"/>
    <position name="j5_motor" joint="joint5" ctrlrange="-2.96 2.96" forcerange="-300 300" kp="3000" kv="100"/>
    <position name="j6_motor" joint="joint6" ctrlrange="-2.09 2.09" forcerange="-300 300" kp="3000" kv="100"/>
    <position name="j7_motor" joint="joint7" ctrlrange="-3.05 3.05" forcerange="-300 300" kp="3000" kv="100"/>
  </actuator>

  <equality>
      <!-- rope ends to prefab lift sites (fl/rl swapped with fr/rr) -->
      <connect site1="rope_fl_end" site2="lift_fr"/>
      <connect site1="rope_fr_end" site2="lift_fl"/>
      <connect site1="rope_rl_end" site2="lift_rr"/>
      <connect site1="rope_rr_end" site2="lift_rl"/>
  </equality>

  <sensor>
    <framepos name="prefab/pos" objtype="site" objname="imu_site"/>
    <framelinvel name="prefab/vel" objtype="site" objname="imu_site"/>
    <framepos name="end/pos" objtype="site" objname="attachment_site"/>
    <framelinvel name="end/vel" objtype="site" objname="attachment_site"/>
  </sensor>

  <!-- Full nq vector: arm home + rope ball joints + prefab free joint -->
  <keyframe>
    <key name="home" qpos="-0.71972016 0.29057466 -1.10685585 1.53851657 2.87907443 1.73055121 -1.85194252 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 1 0 0 0 0.2 0.3 0.5 1 0 0 0"/>
  </keyframe>

</mujoco>
